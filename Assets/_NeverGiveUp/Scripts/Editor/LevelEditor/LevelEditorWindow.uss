.panel { padding: 10px; flex-grow: 1; }
.heading { -unity-font-style: bold; font-size: 14px; margin-top: 12px; margin-bottom: 6px; color: rgb(128,198,246); }
.hint { white-space: normal; color: rgb(175,181,190); margin-top: 4px; margin-bottom: 5px; }
.row { flex-direction: row; flex-wrap: wrap; }
.row > Button { flex-grow: 1; margin-right: 4px; min-height: 25px; }
.status { white-space: normal; margin-top: 8px; padding: 6px; background-color: rgb(43,49,58); }
.notice { white-space: normal; color: rgb(255,197,107); margin-top: 8px; }
